{
  // COMMON
  "editor.formatOnSave": true,

  // PYTHON
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // XML & ZCML & PT
  "files.associations": {
    "*.zcml": "zcml",
    "*.xml": "zcml"
  },
  "[zcml]": {
    "editor.defaultFormatter": "Plone.plone-vs-utilities",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "zcmlLanguage.zprettyoptions": "-z",
  "[tal]": {
    "editor.defaultFormatter": "Plone.plone-vs-utilities",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "talLanguage.zprettyoptions": "-x",

  // JAVASCRIPT
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },

  // CSS
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // SCSS
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
