<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xml:lang="en"
      i18n:domain="collective.concepts"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
>

  <body>
    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">
        <div tal:define="
               self nocall:context/@@faceted-preview-books;
               folderContents folderContents | python:context.getFolderContents();
               Batch python:modules['Products.CMFPlone'].Batch;
               b_start python:request.get('b_start', 0);
               batch python:isinstance(folderContents, Batch) and folderContents or Batch(folderContents, 12, int(b_start), orphan=2);
             ">

          <div metal:use-macro="context/batch_macros/macros/navigation"></div>

          <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-3 my-2">
            <div class="col"
                 tal:repeat="tile python:self.tiles(batch)"
            >
              <div class="card h-100">
                <tal:cover condition="tile/cover"
                           replace="structure tile/cover"
                ></tal:cover>
                <div class="card-body">
                  <span class="badge text-bg-secondary mb-2"
                        tal:condition="tile/category"
                        tal:content="tile/category"
                  >Category</span>
                  <h5 class="card-title"
                      tal:content="tile/title"
                  >Title</h5>
                  <p class="card-text"
                     tal:content="tile/description"
                  >Description</p>
                  <a class="stretched-link"
                     href="#"
                     tal:attributes="
                       href tile/url;
                       title tile/title;
                     "
                     i18n:translate=""
                  >Read more</a>
                </div>
              </div>
            </div>
          </div>

          <span class="table_faceted_no_results"
                tal:condition="not: batch/sequence_length"
                i18n:domain="plone"
                i18n:translate="description_no_results_found"
          >No results were found.</span>

          <div metal:use-macro="context/batch_macros/macros/navigation"></div>

        </div>
      </metal:block>
    </metal:content-core>
  </body>
</html>
