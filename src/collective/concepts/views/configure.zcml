<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >

  <browser:page
      name="view-basic"
      for="*"
      template="basic.pt"
      permission="zope2.View"
      />

  <browser:page
      name="collective-concepts-macros"
      for="*"
      template="macros.pt"
      permission="zope2.View"
      />

  <browser:page
      name="view-with-macro"
      for="*"
      template="withmacro.pt"
      permission="zope2.View"
      />
  <browser:page
      name="view-patterns"
      for="plone.base.interfaces.siteroot.IPloneSiteRoot"
      class=".patterns.PatternsView"
      template="patterns.pt"
      permission="zope2.View"
      layer="collective.concepts.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view-github"
      for="plone.base.interfaces.siteroot.IPloneSiteRoot"
      class=".github.GithubView"
      template="github.pt"
      permission="zope2.View"
      layer="collective.concepts.interfaces.IBrowserLayer"
      />
  <browser:page
      name="view-pages"
      for="plone.base.interfaces.siteroot.IPloneSiteRoot"
      class=".pages.PagesView"
      template="pages.pt"
      permission="zope2.View"
      layer="collective.concepts.interfaces.IBrowserLayer"
      />
  <browser:page
      name="view-library"
      for="plone.base.interfaces.siteroot.IPloneSiteRoot"
      class=".library.LibraryView"
      template="library.pt"
      permission="zope2.View"
      layer="collective.concepts.interfaces.IBrowserLayer"
      />

</configure>
